# ──────────────────────────────────────────────────────────
# Glosano — environment variables template
# Copy to .env and fill in the values for your installation.
# ──────────────────────────────────────────────────────────

# Application
GLOSANO_ENV=dev                              # dev | prod
GLOSANO_LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
GLOSANO_SECRET_KEY=change-me-in-production   # used for session cookies; generate with: openssl rand -hex 32
# Local data directory (dictionary dump cache). Defaults to <repo>/data.
# docker-compose.yml pins it to the app_data volume (/var/lib/glosano).
#GLOSANO_DATA_DIR=

# HTTP port of app-api on the host. A bare port listens on every interface;
# behind a reverse proxy on the same host use 127.0.0.1:8000.
#GLOSANO_BIND=8000
# Proxies trusted to set X-Forwarded-For / X-Forwarded-Proto (read by uvicorn).
# Behind a reverse proxy on the same host with GLOSANO_BIND=127.0.0.1:8000 use "*".
#FORWARDED_ALLOW_IPS=127.0.0.1

# Accounts (ADR-0008)
GLOSANO_ALLOW_PUBLIC_REGISTRATION=true       # set to false once everyone has signed up
# Whoever registers with this email becomes admin. Emails are not verified,
# so set it only while the site is not public; prefer `glosano identity create-admin`.
GLOSANO_INITIAL_ADMIN_EMAIL=

# Database (Postgres)
POSTGRES_USER=flinq
POSTGRES_PASSWORD=flinq
POSTGRES_DB=flinq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
GLOSANO_DATABASE_URL=postgresql+asyncpg://flinq:flinq@postgres:5432/flinq

# Redis
GLOSANO_REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────────────────────
# LLM provider (OpenAI-compatible) — see ADR-0003
# ──────────────────────────────────────────────────────────
GLOSANO_LLM_ENABLED=false
GLOSANO_LLM_BASE_URL=https://api.openai.com/v1
GLOSANO_LLM_API_KEY=
GLOSANO_LLM_MODEL=gpt-4o-mini
GLOSANO_LLM_TIMEOUT_SECONDS=30

# ──────────────────────────────────────────────────────────
# OCR service (optional, external) — see architecture §5.1
# ──────────────────────────────────────────────────────────
GLOSANO_OCR_ENABLED=false
GLOSANO_OCR_BASE_URL=
GLOSANO_OCR_API_KEY=